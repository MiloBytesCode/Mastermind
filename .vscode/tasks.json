{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "cmake-build",                 // the name of this task, which is used in launch.json
        "type": "shell",                        // the following cmd + args will be interpreted as shell commands (i.e. cd /my_directry...)
        "command": "cmake",                     // full command is 'cmake --build {dir specified by cmake}'
        "args":
        [
            "--build",
            "${command:cmake.buildDirectory}"
        ],
        "group": 
        {
            "kind": "build",                    // some organization for this task
            "isDefault": true
        },
        "problemMatcher": ["$gcc"],             // will parse output errors using built-in gcc parser
        "presentation": 
        {
            "reveal": "always"                  // will always bring to attention the window that the build is happening
        }
    }
  ]
}
