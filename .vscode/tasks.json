{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (part a)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "src\\code.cpp",
        "src\\mastermind.cpp",
        "src\\response.cpp",
        "src\\main_parta.cpp",
        "-o",
        "build\\mastermind.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
